# ==============================================================================
# SimpleNotes Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development, or add these variables to your
# Vercel Project Settings (Project -> Settings -> Environment Variables).
# ==============================================================================

# Session Secret Key (Change this in production)
SECRET_KEY=simplenotes-production-secret-key-change-this

# Database Path (Optional: defaults to /tmp/notes.db on Vercel, ./notes.db locally)
# NOTES_DB_PATH=/tmp/notes.db

# ==============================================================================
# EMAIL PROVIDER CONFIGURATION (CHOOSE ONE OPTION BELOW)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Resend (RECOMMENDED FOR VERCEL DEPLOYMENTS)
# ------------------------------------------------------------------------------
# 1. Sign up for free at https://resend.com (3,000 free emails/month)
# 2. Generate an API Key under "API Keys"
# 3. Add RESEND_API_KEY below (or in Vercel Environment Variables)
# Note: By default, onboarding@resend.dev sends to the email address of your Resend account.
# To send to any email address, add and verify your custom domain in Resend.
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=SimpleNotes <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# OPTION 2: Gmail (EASIEST FOR PERSONAL USAGE)
# ------------------------------------------------------------------------------
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Turn on 2-Step Verification if not already enabled.
# 3. Search for "App Passwords" (https://myaccount.google.com/apppasswords)
# 4. Create an App Password for "SimpleNotes" (generates a 16-character code)
# 5. Paste your Gmail address and 16-character code below:
#
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ------------------------------------------------------------------------------
# OPTION 3: Standard SMTP (Outlook, Brevo, SendGrid, Custom SMTP)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=SimpleNotes <your_email@gmail.com>
# SMTP_TLS=true

